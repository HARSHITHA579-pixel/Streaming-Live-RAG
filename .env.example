# Environment Configuration Template for Streaming RAG
# Copy this file to .env and fill in the required API keys and configuration values.
# DO NOT commit .env containing real secrets to version control.

# --- LLM API Configuration ---
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# --- Embedding & Reranker Configuration ---
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
RERANKER_MODEL=rerank-english-v3.0

# --- Retrieval & Indexing Hyperparameters ---
RETRIEVAL_TOP_K_PER_QUERY=4
MIN_EVIDENCE_PER_INTENT=2
RRF_K=60
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Controller Hyperparameters ---
T0_SIMILARITY_THRESHOLD=0.85
T0_MIN_CHUNK_TOKENS=5

# --- Server & Telemetry Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
TELEMETRY_LOG_DIR=logs
DATA_DIR=data
CORPUS_DIR=corpus/raw_docs
